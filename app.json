{
  "expo": {
    "name": "Waggo",
    "slug": "waggo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.faebb.waggo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3059A4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.faebb.waggo"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Waggo usa tu ubicación para que el paseador sepa dónde recoger a tu perro."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "scheme": "waggo",
    "experiments": {
      "typedRoutes": true
    }
  }
}
