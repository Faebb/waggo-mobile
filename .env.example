# Copia a .env (no se versiona). Solo las variables EXPO_PUBLIC_* llegan a la app.
# Web / iOS simulator:
EXPO_PUBLIC_API_URL=http://localhost:8080
# Android emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
# Dispositivo físico con Expo Go: usa la IP de tu PC, ej. http://192.168.1.50:8080
# Tiles del mapa (plantilla https con {z}/{x}/{y}). Vacía = tiles públicos de OpenStreetMap, solo para desarrollo:
# no son para producción de alto tráfico (https://operations.osmfoundation.org/policies/tiles/).
EXPO_PUBLIC_MAP_TILE_URL=
